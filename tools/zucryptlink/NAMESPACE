# No import directive, deliberately, and no Imports: entry in DESCRIPTION to
# permit one. Nothing here calls into zucrypt's namespace: the adapter and the
# backend are linked statically from zucrypt's installed libzucrypt.a, so
# zucrypt never has to be loadable at run time. An importFrom() here would
# hide a regression in exactly the wiring this fixture exists to check -- and
# would make the "runs with zucrypt uninstalled" step in
# tools/check-linking.sh pass for the wrong reason. zukomp's tools/zukomplink
# is the model.
useDynLib(zucryptlink, .registration = TRUE)
export(linked_backend)
export(archive_hash)
export(archive_hmac)
export(archive_derive)
export(archive_segments)
